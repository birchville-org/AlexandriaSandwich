# ==============================================================================
# AlexandriaSandwich Pipeline Environment Configuration
# ==============================================================================

# Mistral AI API Key für OCR-Fallback
# Optional. Falls nicht angegeben oder Pipeline mit --no-mistral aufgerufen wird,
# greift bei Qualitätsdefiziten kein LLM-Fallback, sondern das Tesseract-Ergebnis bleibt erhalten.
MISTRAL_API_KEY=

# Standard-Sprachmodelle für Tesseract OCR (z. B. 'deu+eng', 'deu', 'eng', 'san')
OCR_LANG=deu+eng

# Konfidenz-Schwellenwert (in Prozent, 0-100)
# Fällt die mittlere Seiten-Konfidenz von Tesseract unter diesen Wert, wird Mistral AI angefordert.
OCR_CONFIDENCE_THRESHOLD=85

# Basis-Speicherpfad auf dem Host für Volumes
# Standard für lokalen Schnellstart: ./data
# Für Produktions-Server z. B.: /data oder /mnt/storage/alexandria
DATA_DIR=./data

# Port-Konfiguration für Web-Services (bei Nutzung von Compose-Profilen)
PORT_UI=8080
PORT_N8N=5678

# Hostname für n8n Webhook-Callbacks (z. B. localhost oder alex.local)
N8N_HOST=localhost

# ------------------------------------------------------------------------------
# Web UI & Exposition (Optional)
# ------------------------------------------------------------------------------
# Öffentliche Basis-URL der Instanz (z. B. https://alex.birchville.org oder leer für lokal)
PUBLIC_URL=http://localhost:8080

# Externer SSO / Auth Login-Endpunkt (z. B. Authelia 2FA).
# Wenn leer, arbeitet die UI im autarken Modus ohne externes SSO.
AUTH_LOGIN_URL=

# Externe Navigations- und Editionsprojekte einblenden (true/false)
SHOW_PROJECT_LINKS=false

# Ingress-Bezeichnung für das System-Dashboard (z. B. "Traefik v3 + Authelia 2FA" oder "Lokal / Standalone")
INGRESS_LABEL=Lokal / Standalone
